  "detected_stack": {
    "application": "Next.js App Router application for a closed-beta founder matchmaking product",
    "frontend": ["Next.js 15.1.5", "React 19", "TypeScript 5.7", "Tailwind CSS 3.4", "Framer Motion"],
    "backend": ["Next.js route handlers", "Supabase SSR/client", "Anthropic SDK", "Upstash Redis/Ratelimit", "Zod"],
    "database": ["Supabase Postgres migrations", "PocketBase schema present but not wired into runtime"],
    "testing": ["Playwright e2e", "AI agent eval scripts"],
    "deployment": ["Vercel", "vercel.json headers/cron"],
    "analytics": ["ELU Analytics script"]
