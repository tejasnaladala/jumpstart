    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "supabase db push",
    "db:generate": "bunx supabase gen types typescript --local > src/lib/database.types.ts && bun run scripts/generate-types.ts",
    "db:seed": "bun run scripts/seed-cohort.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:agents": "bun run evals/run-agents.ts"
