# Anthropic key. Without this, agents fall back to local heuristics so the dev
# experience still works end to end.
ANTHROPIC_API_KEY=

# Supabase. Optional in dev (we use local mocks at /lib/mock).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email). Optional in dev.
RESEND_API_KEY=

# PostHog (analytics). Optional in dev.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Mode flag. Set to "1" to force stub-only behavior even with keys present.
JUMPSTART_FORCE_STUBS=

# Allow stub-mode auth (deterministic dev session). Required for local dev
# without Supabase. NEVER set this in production.
JUMPSTART_ALLOW_STUB=

# Upstash for rate limiting. Free tier is enough for the closed beta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron auth. Used by /api/cron/retention. Must match the Authorization
# Bearer token Vercel Cron sends.
CRON_SECRET=
