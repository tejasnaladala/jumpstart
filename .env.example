# =============================================================================
# Jumpstart environment variables
# =============================================================================
# Mode flags interact in load-bearing ways. Read the "Flag matrix" section
# at the bottom of this file before flipping any of them in production.
# =============================================================================

# == Two-Claude collaboration ==
# Used by harness/scripts/delegation-loop.ts to @-mention Mukund's GitHub
# handle in the auto-nudge comments it posts on status:ready issues. Without
# this set, nudges still post but as plain text without the at-mention.
JUMPSTART_MUKUND_HANDLE=

# == Anthropic ==
# Without this, agents fall back to local heuristics so the dev experience
# still works end to end. Required in production unless JUMPSTART_FORCE_STUBS=1.
ANTHROPIC_API_KEY=

# == Supabase ==
# Optional in dev (we use local mocks at /lib/mock). Required in production
# unless JUMPSTART_ALLOW_STUB=1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# == Resend (transactional email) ==
# Optional in dev. Required in production for intro accept emails AND for
# real OTP email delivery (issue #2). Without it, OTP send falls back to
# stub mode.
RESEND_API_KEY=

# == OTP delivery (issue #2) ==
# Wire up real OTP delivery: PocketBase for storage, Resend for email,
# Twilio for phone. JUMPSTART_FORCE_STUBS=1 short-circuits all of these
# back to localStorage stub so closed-beta-of-2 keeps working with no
# backend services.
#
# OTP_HASH_PEPPER: 32+ char random hex used to salt server-side SHA-256
# hashes of (channel + target + code). Server-only — never ship to
# client. Generate with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
OTP_HASH_PEPPER=

# OTP_FROM_EMAIL: verified Resend sender address used for OTP emails.
# Must be a sender-verified domain in Resend before real-mode goes live.
OTP_FROM_EMAIL=

# Twilio: programmable messaging account. Twilio account SID + auth
# token for the API; from-phone in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# == PocketBase (closed-beta backend, OTP store) ==
# NEXT_PUBLIC_POCKETBASE_URL is read by the browser; same value lands in
# POCKETBASE_URL for server-side use. POCKETBASE_ADMIN_* authenticates
# the server-side admin SDK client used by the OTP route handlers.
NEXT_PUBLIC_POCKETBASE_URL=
POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# == PostHog (product analytics) ==
# Optional in dev. Wired into the app via the root layout.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# == Upstash (rate limiting) ==
# Free tier is enough for the closed beta of 10. Required in production
# unless JUMPSTART_PRIVATE_BETA=1 (which permits the in-memory fallback).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# == Cron auth ==
# Used by /api/cron/retention. Must match the Authorization Bearer token
# Vercel Cron sends.
CRON_SECRET=

# =============================================================================
# Mode flags (load-bearing — read the matrix at the bottom)
# =============================================================================

# Force stub-only behavior even with real keys present. Useful for offline
# work on a plane. Set to "1" to enable.
JUMPSTART_FORCE_STUBS=

# Allow stub-mode auth (deterministic dev session). Required for local dev
# without Supabase. NEVER set this in production unless you know what you're
# doing (it bypasses real auth).
JUMPSTART_ALLOW_STUB=

# Allow the in-memory rate-limit fallback in production AND opt-in to the
# stub-mode health response. Used when running a tunneled private beta
# (cloudflared) before real Upstash + Supabase are provisioned. Set to "1"
# only for tunneled private beta. NEVER for the public beta.
JUMPSTART_PRIVATE_BETA=

# When paired with JUMPSTART_PRIVATE_BETA=1, also bypass admin auth so the
# founder can hit /admin without a real session. Set to "1" for tunneled
# private beta only.
JUMPSTART_DEV_ADMIN=

# Comma-separated list of admin emails. Authoritative allowlist for /admin
# in production. Empty string disables admin in prod entirely.
JUMPSTART_ADMIN_EMAILS=

# Hard kill switch for Anthropic calls. Set to "1" to disable all agent
# requests; the runner short-circuits to local heuristics. Use during a
# spend incident or if Anthropic is down. Independent of JUMPSTART_FORCE_STUBS.
JUMPSTART_DISABLE_ANTHROPIC=

# =============================================================================
# Flag matrix
# =============================================================================
# | Mode                       | FORCE_STUBS | ALLOW_STUB | PRIVATE_BETA | DEV_ADMIN | DISABLE_ANTHROPIC |
# |----------------------------|-------------|------------|--------------|-----------|-------------------|
# | Local dev (full stubs)     |      —      |      1     |       —      |     —     |         —         |
# | Local dev (real Anthropic) |      —      |      1     |       —      |     —     |         —         |
# | Tunneled private beta      |      —      |      1     |       1      |     1     |         —         |
# | Production (real)          |      —      |      —     |       —      |     —     |         —         |
# | Anthropic spend incident   |   prod-set  |      —     |       —      |     —     |         1         |
#
# Flag interactions:
# - JUMPSTART_PRIVATE_BETA=1 unlocks (a) in-memory rate limiter in prod,
#   (b) stub-friendly /api/health response, (c) the dev-admin bypass when
#   paired with JUMPSTART_DEV_ADMIN=1.
# - JUMPSTART_ALLOW_STUB=1 only authorizes the deterministic DEV_USER
#   session and the middleware bypass. Narrower than PRIVATE_BETA.
# - JUMPSTART_FORCE_STUBS=1 short-circuits all real-service calls even
#   when keys are present. Useful for plane-mode demos.
# - JUMPSTART_DISABLE_ANTHROPIC=1 is the panic switch. Independent of the
#   other flags so the founder can hit it during a runaway-loop incident
#   without changing auth or rate-limit posture.
# =============================================================================
